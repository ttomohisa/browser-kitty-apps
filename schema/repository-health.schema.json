{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-kitty.com/schemas/repository-health.schema.json",
  "title": "Browser Kitty Repository Health Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRegistry",
    "overallStatus",
    "sources",
    "summary",
    "globalIssues",
    "applications"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRegistry": { "const": "apps.json" },
    "overallStatus": { "$ref": "#/$defs/status" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "quality", "pages", "releases", "runtime"],
      "properties": {
        "inventory": { "$ref": "#/$defs/source" },
        "quality": { "$ref": "#/$defs/source" },
        "pages": { "$ref": "#/$defs/source" },
        "releases": { "$ref": "#/$defs/source" },
        "runtime": { "$ref": "#/$defs/source" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registeredApps",
        "checkedApps",
        "pass",
        "warn",
        "fail",
        "warnings",
        "failures",
        "globalIssues"
      ],
      "properties": {
        "registeredApps": { "type": "integer", "minimum": 0 },
        "checkedApps": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "globalIssues": { "type": "integer", "minimum": 0 }
      }
    },
    "globalIssues": {
      "type": "array",
      "items": { "$ref": "#/$defs/healthIssue" }
    },
    "applications": {
      "type": "array",
      "items": { "$ref": "#/$defs/application" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "checkStatus": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "UNKNOWN"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "available", "generatedAt", "error"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "generatedAt": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "healthIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "source", "code", "message", "path"],
      "properties": {
        "severity": { "type": "string", "enum": ["WARN", "FAIL"] },
        "source": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "name",
        "nameJa",
        "repository",
        "registryStatus",
        "published",
        "version",
        "overallStatus",
        "checks",
        "issueCounts",
        "issues"
      ],
      "properties": {
        "appId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nameJa": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 3 },
        "registryStatus": { "type": "string", "minLength": 1 },
        "published": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1 },
        "overallStatus": { "$ref": "#/$defs/status" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventory", "quality", "pages", "releases", "runtime"],
          "properties": {
            "inventory": { "$ref": "#/$defs/checkStatus" },
            "quality": { "$ref": "#/$defs/checkStatus" },
            "pages": { "$ref": "#/$defs/checkStatus" },
            "releases": { "$ref": "#/$defs/checkStatus" },
            "runtime": { "$ref": "#/$defs/checkStatus" }
          }
        },
        "issueCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warn", "fail"],
          "properties": {
            "warn": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 }
          }
        },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/healthIssue" }
        }
      }
    }
  }
}
