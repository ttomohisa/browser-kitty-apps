{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browser-kitty.com/schema/repository-quality.schema.json",
  "title": "Browser Kitty Repository Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRegistry",
    "sourceInventory",
    "githubApi",
    "authenticated",
    "policy",
    "summary",
    "repositories"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceRegistry": { "type": "string", "const": "apps.json" },
    "sourceInventory": { "type": "string", "minLength": 1 },
    "githubApi": { "type": "string", "pattern": "^https://" },
    "authenticated": { "type": "boolean" },
    "policy": { "$ref": "#/definitions/policy" },
    "summary": { "$ref": "#/definitions/summary" },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/definitions/repository" }
    }
  },
  "definitions": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCoreFiles", "releaseScreenshotFiles", "packageJsonRequired"],
      "properties": {
        "requiredCoreFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "releaseScreenshotFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "packageJsonRequired": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registeredApps", "checkedApps", "pass", "warn", "fail", "lookupErrors"],
      "properties": {
        "registeredApps": { "type": "integer", "minimum": 0 },
        "checkedApps": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "lookupErrors": { "type": "integer", "minimum": 0 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "name",
        "repository",
        "registryStatus",
        "published",
        "lookupStatus",
        "qualityStatus",
        "defaultBranch",
        "treeTruncated",
        "files",
        "issues",
        "error"
      ],
      "properties": {
        "appId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "registryStatus": {
          "type": "string",
          "enum": ["development", "rc", "stable", "maintenance", "archived"]
        },
        "published": { "type": "boolean" },
        "lookupStatus": { "type": "string", "enum": ["ok", "error"] },
        "qualityStatus": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "defaultBranch": { "type": ["string", "null"] },
        "treeTruncated": { "type": "boolean" },
        "files": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/files" }
          ]
        },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "license", "appConfig", "packageJson", "favicon", "screenshot", "screenshotEn"],
      "properties": {
        "readme": { "type": "boolean" },
        "license": { "type": "boolean" },
        "appConfig": { "type": "boolean" },
        "packageJson": { "type": "boolean" },
        "favicon": { "type": "boolean" },
        "screenshot": { "type": "boolean" },
        "screenshotEn": { "type": "boolean" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["WARN", "FAIL"] },
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
