{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-kitty.com/schema/release-candidate.schema.json",
  "title": "Browser Kitty Apps release readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "releaseVersion",
    "overallStatus",
    "summary",
    "checks",
    "health"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseVersion": {
      "type": "string"
    },
    "overallStatus": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registeredApps",
        "publishedApps",
        "categories",
        "checks",
        "pass",
        "warn",
        "fail"
      ],
      "properties": {
        "registeredApps": {
          "type": "integer",
          "minimum": 0
        },
        "publishedApps": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "available",
        "overallStatus",
        "pass",
        "warn",
        "fail",
        "warnings",
        "failures"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "overallStatus": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            null
          ]
        },
        "pass": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fail": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warnings": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failures": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
