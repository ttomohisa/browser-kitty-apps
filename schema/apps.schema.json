{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browser-kitty.com/schema/apps.schema.json",
  "title": "Browser Kitty Apps Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/app"
      }
    }
  },
  "definitions": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nameJa",
        "repository",
        "repositoryProfile",
        "category",
        "status",
        "browserKitty",
        "release",
        "pages",
        "runtime"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nameJa": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "development",
            "rc",
            "stable",
            "maintenance",
            "archived"
          ]
        },
        "browserKitty": {
          "$ref": "#/definitions/browserKitty"
        },
        "release": {
          "$ref": "#/definitions/release"
        },
        "pages": {
          "$ref": "#/definitions/pages"
        },
        "runtime": {
          "$ref": "#/definitions/runtime"
        },
        "hosting": {
          "$ref": "#/definitions/hosting"
        },
        "template": {
          "$ref": "#/definitions/template"
        },
        "repositoryProfile": {
          "type": "string",
          "enum": [
            "standard",
            "legacy"
          ]
        }
      }
    },
    "browserKitty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published",
        "slug"
      ],
      "properties": {
        "published": {
          "type": "boolean"
        },
        "slug": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standalone",
        "standalonePath",
        "localProcessing",
        "networkAccess",
        "crossOriginIsolated",
        "requiresWasm",
        "requiresWorker",
        "requiresWebGPU",
        "requiresWebCodecs"
      ],
      "properties": {
        "standalone": {
          "type": "boolean"
        },
        "standalonePath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "localProcessing": {
          "type": "boolean"
        },
        "networkAccess": {
          "type": "boolean"
        },
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "requiresWasm": {
          "type": "boolean"
        },
        "requiresWorker": {
          "type": "boolean"
        },
        "requiresWebGPU": {
          "type": "boolean"
        },
        "requiresWebCodecs": {
          "type": "boolean"
        }
      }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crossOriginIsolated",
        "headers"
      ],
      "properties": {
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "headers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "template": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
