{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browser-kitty.com/schema/repository-pages.schema.json",
  "title": "Browser Kitty Pages Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceRegistry", "policy", "summary", "applications"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceRegistry": { "type": "string", "const": "apps.json" },
    "policy": { "$ref": "#/definitions/policy" },
    "summary": { "$ref": "#/definitions/summary" },
    "applications": { "type": "array", "items": { "$ref": "#/definitions/application" } }
  },
  "definitions": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishedRequires2xx", "acceptedContentTypes", "maxRedirects", "requestMethod"],
      "properties": {
        "publishedRequires2xx": { "type": "boolean" },
        "acceptedContentTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "maxRedirects": { "type": "integer", "minimum": 0 },
        "requestMethod": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registeredApps", "checkedApps", "pass", "warn", "fail", "lookupErrors"],
      "properties": {
        "registeredApps": { "type": "integer", "minimum": 0 },
        "checkedApps": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "lookupErrors": { "type": "integer", "minimum": 0 }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "name", "repository", "registryStatus", "published", "url", "lookupStatus", "pagesStatus", "httpStatus", "finalUrl", "contentType", "issues", "error"],
      "properties": {
        "appId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "registryStatus": { "type": "string", "enum": ["development", "rc", "stable", "maintenance", "archived"] },
        "published": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^https://" },
        "lookupStatus": { "type": "string", "enum": ["ok", "error"] },
        "pagesStatus": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "httpStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "finalUrl": { "type": ["string", "null"] },
        "contentType": { "type": ["string", "null"] },
        "issues": { "type": "array", "items": { "$ref": "#/definitions/issue" } },
        "error": { "type": ["string", "null"] }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["WARN", "FAIL"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
